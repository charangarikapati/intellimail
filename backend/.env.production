# IntelliMail Backend — Production Environment Variables
# Copy this file and set these values as Environment Variables on Render.com
# DO NOT commit actual secret values to GitHub — use Render's dashboard to set them.

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Must match EXACTLY what you added in Google Cloud Console → Authorized Redirect URIs
# Format: https://<your-render-service-name>.onrender.com/auth/google/callback
GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/auth/google/callback

# ── Frontend URL (for OAuth callback redirect) ────────────────────────────────
# Your Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app

# ── CORS Origins (comma-separated, no spaces) ─────────────────────────────────
ALLOWED_ORIGINS=https://your-app.vercel.app,https://www.your-custom-domain.com

# ── Google Gemini AI ──────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Firebase ─────────────────────────────────────────────────────────────────
# Option A: Path to service account JSON file (if you upload it to Render as a secret file)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
# Option B: Project ID (if using Application Default Credentials)
FIREBASE_PROJECT_ID=your_firebase_project_id

# ── App Settings ─────────────────────────────────────────────────────────────
ENVIRONMENT=production
SECRET_KEY=generate_a_long_random_string_here_min_32_chars
PORT=8000
