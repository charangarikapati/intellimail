# IntelliMail Backend Environment Configuration Template

# Server Configuration
HOST=127.0.0.1
PORT=8000
SECRET_KEY=change_this_to_a_secure_random_32_byte_secret_key

# Google OAuth 2.0 (Leave empty for High-Fidelity Demo Mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Google Gemini AI (Leave empty to use built-in heuristic NLP fallbacks)
GEMINI_API_KEY=

# Firebase Admin SDK (Leave empty for in-memory session logging)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
